
# ==========================================
# RiskPulse AI - Git Ignore Configuration
# ==========================================

# ---------- Environment variables and secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
secrets.json
credentials.json

# ---------- Node.js / Next.js ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/
.turbo/
.vercel/

# ---------- Testing and coverage ----------
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------- Python virtual environments ----------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ---------- Python cache and compiled files ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
htmlcov/

# ---------- Python packaging ----------
build/
develop-eggs/
dist/
eggs/
wheels/
*.egg-info/

# ---------- Logs and debug files ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Local databases ----------
*.sqlite
*.sqlite3
*.db
*.db-journal

# ---------- Local uploads and runtime data ----------
.data/uploads/
uploads/

# ---------- Machine learning generated artifacts ----------
# Ignore generated models and checkpoints if they are large/local.
# Keep small, intentional project assets and source code.
*.ckpt
*.pth
*.pt
*.onnx

# ---------- IDE and operating system ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- TypeScriapt ----------
*.tsbuildinfo
next-env.d.ts
